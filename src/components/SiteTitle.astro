---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const logo = import.meta.env.BASE_URL.replace(/\/$/, '') + '/media/brand.jpg';
---
<a href={siteTitleHref} class="brand">
  <img src={logo} alt="" width="38" height="34" />
  <span translate="no">{siteTitle}</span>
</a>
<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: var(--sl-color-white);
    font-size: 1.3rem;
    font-weight: 720;
    letter-spacing: -.05em;
    line-height: 1;
    text-decoration: none;
  }
  img {
    display: block;
    width: 2.15rem;
    height: 2rem;
    object-fit: contain;
    padding: .12rem;
    border-radius: .3rem;
    background: white;
  }
</style>
